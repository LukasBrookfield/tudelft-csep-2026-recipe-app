                                                <ChoiceBox fx:id="editIngredientChoiceBox" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="225.0" HBox.hgrow="ALWAYS" />
                                                <TextField fx:id="editIngredientNameField" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="165.0" promptText="Ingredient type" HBox.hgrow="ALWAYS" />
                                                <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                                   <HBox.margin>
                                                      <Insets left="-2.5" right="-2.5" />
                                                   </HBox.margin>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="5.0">
                                                   <children>
                                                      <Button fx:id="cancelEditIngredientButton" alignment="CENTER" minWidth="-Infinity" mnemonicParsing="false" onAction="#onCancelEditIngredientButton" text="Cancel" textAlignment="CENTER" />
                                                      <Button fx:id="nextButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNext" text="Next" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </HBox>
                                       </children>
                                    </StackPane>
                                    <HBox spacing="5.0">
                                       <children>
                                          <Button fx:id="removeIngredientButton" mnemonicParsing="false" onAction="#onRemoveIngredientButton" prefHeight="25.0" prefWidth="25.0" text="✕">
                                             <font>
                                                <Font size="9.0" />
                                             </font>
                                             <tooltip>
                                                <Tooltip text="Remove ingredient">
                                                   <font>
                                                      <Font size="13.0" />
                                                   </font>
                                                </Tooltip>
                                             </tooltip>
                                          </Button>
                                          <Button fx:id="addIngredientButton" alignment="TOP_CENTER" contentDisplay="TOP" mnemonicParsing="false" onAction="#onAddIngredientButton" prefHeight="25.0" prefWidth="25.0" text="+">
                                             <HBox.margin>
                                                <Insets />
                                             </HBox.margin>
                                             <tooltip>
                                                <Tooltip text="Add ingredient">
                                                   <font>
                                                      <Font size="13.0" />
                                                   </font>
                                                </Tooltip>
                                             </tooltip>
                                          </Button>
                                          <Button fx:id="editIngredientButton" mnemonicParsing="false" onAction="#onEditIngredientButton" prefHeight="25.0" prefWidth="28.0" text="✎">
                                             <tooltip>
                                                <Tooltip text="Edit ingredient">
                                                   <font>
                                                      <Font size="13.0" />
                                                   </font>
                                                </Tooltip>
                                             </tooltip>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                                 <padding>
                                    <Insets top="-3.0" />
                                 </padding>
                                 <HBox.margin>
                                    <Insets />
                                 </HBox.margin>
                              </StackPane>
                           </children>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </HBox>
