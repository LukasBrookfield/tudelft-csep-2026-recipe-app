                              <Font name="System Bold" size="16.0" />
                           </font>
                           <padding>
                              <Insets left="5.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
               </top>
               <center>
                  <VBox fx:id="recipeDetailsVBox" prefHeight="200.0" prefWidth="100.0" spacing="3.0" BorderPane.alignment="CENTER">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                     </padding>
                     <children>
                        <Label prefHeight="27.0" prefWidth="91.0" text="Shopping List">
