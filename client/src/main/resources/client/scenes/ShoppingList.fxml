                        </Label>
                        <Separator prefWidth="200.0" />
                        <ListView fx:id="ingredientListView" prefHeight="355.0" prefWidth="570.0" />
                        <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="395.0" spacing="5.0">
                           <children>
                              <StackPane prefHeight="25.0" prefWidth="437.0">
                                 <children>
                                    <StackPane fx:id="editPane" prefHeight="25.0" prefWidth="455.0">
                                       <children>
                                          <HBox fx:id="editIngredientBox" prefHeight="25.0" prefWidth="457.0" spacing="5.0">
                                             <children>
                                                <TextField fx:id="editIngredientAmountField" prefHeight="25.0" prefWidth="217.0" promptText="Amount" />
                                                <ChoiceBox fx:id="editUnitBox" prefHeight="25.0" prefWidth="47.0" />
                                                <Button mnemonicParsing="false" onAction="#onBackEditIngredientButton" text="Back" />
                                                <Button fx:id="doneEditIngredientButton" mnemonicParsing="false" onAction="#onDoneEditIngredientButton" prefHeight="25.0" prefWidth="53.0" text="Done" />
                                             </children>
                                          </HBox>
                                          <HBox fx:id="editIngredientTypeBox" prefHeight="25.0" prefWidth="454.0" spacing="5.0">
                                             <children>
                                                <ChoiceBox fx:id="editIngredientChoiceBox" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="209.0" />
                                                <TextField fx:id="editIngredientNameField" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="101.0" promptText="Ingredient type" />
                                                <Button fx:id="nextButton" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNext" prefHeight="25.0" prefWidth="53.0" text="Next" />
                                             </children>
                                          </HBox>
                                          <Button fx:id="cancelEditIngredientButton" alignment="CENTER" mnemonicParsing="false" onAction="#onCancelEditIngredientButton" prefHeight="25.0" prefWidth="58.0" text="Cancel" textAlignment="CENTER" StackPane.alignment="TOP_RIGHT" />
