<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="478.67" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ShoppingListCtrl">
   <children>
      <AnchorPane fx:id="rootPane" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <top>
                  <HBox alignment="CENTER_LEFT" prefHeight="33.0" prefWidth="400.0" BorderPane.alignment="CENTER">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                     <children>
                        <Label alignment="BOTTOM_LEFT" prefHeight="25.0" prefWidth="137.0" text="🍽 FoodPal" textFill="#589ed5">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                           <padding>
                              <Insets left="5.0" />
                           </padding>
                        </Label>
                        <HBox prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" prefHeight="33.0" prefWidth="428.0" spacing="5.0">
                           <children>
                              <Button fx:id="downloadButton" mnemonicParsing="false" onAction="#onDownloadButton" text="Download" />
                              <Button fx:id="printButton" mnemonicParsing="false" onAction="#onPrintButton" text="Print" />
                              <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onResetButton" text="Reset" />
