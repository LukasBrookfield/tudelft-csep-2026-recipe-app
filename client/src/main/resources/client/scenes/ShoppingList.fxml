                              <ChoiceBox fx:id="sceneBox" prefWidth="140.0" />
                           </children>
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                        </HBox>
                     </children>
                     <BorderPane.margin>
                        <Insets top="5.0" />
                     </BorderPane.margin>
                  </HBox>
               </top>
               <center>
                  <VBox fx:id="recipeDetailsVBox" spacing="8.0" BorderPane.alignment="CENTER">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                     </padding>
                     <children>
                        <Label fx:id="shoppingListHeaderLabel" prefHeight="19.0" prefWidth="170.0" text="Shopping List">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <Separator prefWidth="200.0" />
                        <ListView fx:id="ingredientListView" prefHeight="355.0" prefWidth="570.0" />
                        <HBox spacing="5.0">
                           <children>
                              <StackPane alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                 <children>
                                    <StackPane fx:id="editPane">
                                       <children>
                                          <HBox fx:id="editIngredientBox" spacing="5.0" visible="false">
                                             <children>
                                                <ChoiceBox fx:id="editUnitBox" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="195.0" />
                                                <TextField fx:id="editIngredientAmountField" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="195.0" promptText="Amount" />
                                                <HBox HBox.hgrow="ALWAYS">
                                                   <HBox.margin>
                                                      <Insets left="-2.5" right="-2.5" />
                                                   </HBox.margin>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="5.0">
                                                   <children>
                                                      <Button fx:id="backEditIngredientButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onBackEditIngredientButton" text="Back" />
                                                      <Button fx:id="doneEditIngredientButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onDoneEditIngredientButton" text="Done" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </HBox>
                                          <HBox fx:id="editIngredientTypeBox" spacing="5.0">
