<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" prefHeight="478.67" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.HomeScreenCtrl">
   <children>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <BorderPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <center>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" BorderPane.alignment="CENTER">
                     <children>
                        <Label text="🍽 FoodPal" textFill="#589ed5">
                           <font>
                              <Font name="System Bold" size="36.0" />
                           </font>
                        </Label>
                        <Button fx:id="recipeOverviewButton" mnemonicParsing="false" onAction="#onRecipeOverviewButton" prefWidth="183.3" text="Recipe overview" />
                        <Button fx:id="ingredientOverviewButton" mnemonicParsing="false" onAction="#onIngredientOverviewButton" prefWidth="183.3" text="Ingredient overview" />
                        <Button fx:id="shoppingListButton" mnemonicParsing="false" onAction="#onShoppingListButton" prefWidth="183.3" text="Shopping list" />
                     </children>
                  </VBox>
               </center>
               <top>
                  <HBox BorderPane.alignment="CENTER">
                     <children>
                        <HBox prefHeight="33.3" HBox.hgrow="ALWAYS" />
                        <fx:include source="LanguagePicker.fxml" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                     <BorderPane.margin>
                        <Insets right="10.0" top="5.0" />
                     </BorderPane.margin>
                  </HBox>
               </top>
            </BorderPane>
<!--             <fx:include source="LanguagePicker.fxml" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0" />-->
         </children>
      </AnchorPane>
   </children>
</VBox>
